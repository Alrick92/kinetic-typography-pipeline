# UniScribe API
UNISCRIBE_API_KEY=
UNISCRIBE_BASE_URL=https://api.uniscribe.co

# Local paths
CACHE_DIR=./.cache
OUTPUT_DIR=./output

# API server (for n8n trigger or direct HTTP use)
WEBHOOK_PORT=4000
# Optional shared-secret auth — if set, clients must send X-API-Key: <value>.
# Leave blank for local/internal-only use; set it once the API is exposed publicly.
API_KEY=
# Max render pipelines (transcription-wait + headless-Chrome render) running at
# once; extra requests wait in a FIFO queue. Each render is CPU/RAM-heavy, so keep
# this at 1 on a modest single/dual-core VPS. Raise it only if you've confirmed the
# host can handle multiple concurrent Chromium renders without starving them all.
MAX_CONCURRENT_RENDERS=1

# Logging
LOG_LEVEL=info
