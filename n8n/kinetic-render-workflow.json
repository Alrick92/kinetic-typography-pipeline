{
  "name": "Kinetic Typography - Upload & Wait",
  "nodes": [
    {
      "parameters": {
        "content": "## Setup\n1. Open **Config** and set `apiBaseUrl` to where the Kinetic Typography API is reachable from n8n (e.g. `http://kinetic-typography:4000` on the same Docker network, or `http://localhost:4000`).\n2. If the API has `API_KEY` set, put the same value in `apiKey`.\n3. Activate this workflow, open the **Kinetic Render Form** node, and copy its Production URL \u2014 open that URL in a browser to use the form.\n\n## What it does\nA person opens the form, uploads an audio file (and optionally a cover image), picks\none of the four styles and a color theme, and optionally overrides individual colors. The page doesn't respond until the video is fully rendered\n(transcription + render can take minutes) \u2014 the finished MP4 downloads directly.\nOutput filename matches the upload (`episode.mp3` \u2192 `episode.mp4`) automatically.\n\nSee docs/N8N_WORKFLOW.md for timeout settings you may need to raise (n8n, and any\nreverse proxy in front of it) and for calling this programmatically instead of via browser.",
        "height": 400,
        "width": 440
      },
      "id": "b1a1a1a1-0001-4a1a-8a1a-000000000001",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -380,
        -160
      ]
    },
    {
      "parameters": {
        "formTitle": "Kinetic Typography Render",
        "formDescription": "Upload an audio file, pick a style and a color theme, and optionally adjust individual colors and add a cover image.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Audio File",
              "fieldType": "file",
              "requiredField": true,
              "acceptFileTypes": ".mp3,.wav,.m4a,.aac,.ogg,.opus,.flac,.mp4,.webm,.mov",
              "multipleFiles": false
            },
            {
              "fieldLabel": "Style",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "focus-word"
                  },
                  {
                    "option": "clean-feed"
                  },
                  {
                    "option": "vertical-show"
                  },
                  {
                    "option": "orbit"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Color Theme",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "style default"
                  },
                  {
                    "option": "midnight-lime"
                  },
                  {
                    "option": "electric-blue"
                  },
                  {
                    "option": "cream-coral"
                  },
                  {
                    "option": "lime-violet"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Cover Image",
              "fieldType": "file",
              "requiredField": false,
              "acceptFileTypes": ".jpg,.jpeg,.png,.webp",
              "multipleFiles": false
            },
            {
              "fieldLabel": "Background Color",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "Optional: overrides the theme's background. A preset (White, Black, Grey, Silver, Blue) or any hex like #1E88E5"
            },
            {
              "fieldLabel": "Font Color",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "Optional: overrides the theme's text color, hex like #FFFFFF"
            },
            {
              "fieldLabel": "Highlight Color",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "Optional: overrides the theme's bold/current-word color, hex like #FFD400"
            },
            {
              "fieldLabel": "Title",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "Only used by Vertical Show / Orbit; defaults to the filename"
            },
            {
              "fieldLabel": "Description",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "Only used by Vertical Show / Orbit"
            },
            {
              "fieldLabel": "Episode Label",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "Only used by Orbit, e.g. EP. 12"
            },
            {
              "fieldLabel": "Language Code",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "en"
                  },
                  {
                    "option": "es"
                  },
                  {
                    "option": "fr"
                  },
                  {
                    "option": "de"
                  },
                  {
                    "option": "pt"
                  },
                  {
                    "option": "it"
                  },
                  {
                    "option": "nl"
                  },
                  {
                    "option": "ja"
                  },
                  {
                    "option": "ko"
                  },
                  {
                    "option": "zh"
                  },
                  {
                    "option": "ru"
                  },
                  {
                    "option": "ar"
                  },
                  {
                    "option": "hi"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1a1a1a1-0002-4a1a-8a1a-000000000002",
      "name": "Kinetic Render Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -380,
        260
      ],
      "webhookId": "kinetic-render-form"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "map-1",
              "name": "style",
              "type": "string",
              "value": "={{ $json['Style'] }}"
            },
            {
              "id": "map-1b",
              "name": "theme",
              "type": "string",
              "value": "={{ $json['Color Theme'] === 'style default' ? '' : ($json['Color Theme'] || '') }}"
            },
            {
              "id": "map-2b",
              "name": "background",
              "type": "string",
              "value": "={{ ($json['Background Color'] || '').toLowerCase() }}"
            },
            {
              "id": "map-3",
              "name": "languageCode",
              "type": "string",
              "value": "={{ $json['Language Code'] }}"
            },
            {
              "id": "map-4",
              "name": "title",
              "type": "string",
              "value": "={{ $json['Title'] || '' }}"
            },
            {
              "id": "map-5",
              "name": "description",
              "type": "string",
              "value": "={{ $json['Description'] || '' }}"
            },
            {
              "id": "map-6",
              "name": "episodeLabel",
              "type": "string",
              "value": "={{ $json['Episode Label'] || '' }}"
            },
            {
              "id": "map-7",
              "name": "fontColor",
              "type": "string",
              "value": "={{ ($json['Font Color'] || '') }}"
            },
            {
              "id": "map-8",
              "name": "highlightColor",
              "type": "string",
              "value": "={{ ($json['Highlight Color'] || '') }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "b1a1a1a1-0003-4a1a-8a1a-000000000003",
      "name": "Read Form Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -160,
        260
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "apiBaseUrl",
              "type": "string",
              "value": "http://localhost:4000"
            },
            {
              "id": "cfg-2",
              "name": "apiKey",
              "type": "string",
              "value": ""
            },
            {
              "id": "cfg-3",
              "name": "pollSeconds",
              "type": "number",
              "value": 15
            },
            {
              "id": "cfg-4",
              "name": "maxAttempts",
              "type": "number",
              "value": 80
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "b1a1a1a1-0004-4a1a-8a1a-000000000004",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        60,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/render",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $json.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formData",
              "name": "style",
              "value": "={{ $json.style }}"
            },
            {
              "parameterType": "formData",
              "name": "theme",
              "value": "={{ $json.theme }}"
            },
            {
              "parameterType": "formData",
              "name": "background",
              "value": "={{ $json.background }}"
            },
            {
              "parameterType": "formData",
              "name": "title",
              "value": "={{ $json.title }}"
            },
            {
              "parameterType": "formData",
              "name": "description",
              "value": "={{ $json.description }}"
            },
            {
              "parameterType": "formData",
              "name": "episodeLabel",
              "value": "={{ $json.episodeLabel }}"
            },
            {
              "parameterType": "formData",
              "name": "languageCode",
              "value": "={{ $json.languageCode }}"
            },
            {
              "parameterType": "formData",
              "name": "fontColor",
              "value": "={{ $json.fontColor }}"
            },
            {
              "parameterType": "formData",
              "name": "highlightColor",
              "value": "={{ $json.highlightColor }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "audio",
              "inputDataFieldName": "={{ Object.keys($binary || {}).find(k => /audio/i.test(k)) ?? Object.keys($binary || {})[0] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1a1a1-0005-4a1a-8a1a-000000000005",
      "name": "Upload Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        140
      ]
    },
    {
      "parameters": {
        "amount": "={{ $('Config').item.json.pollSeconds }}",
        "unit": "seconds"
      },
      "id": "b1a1a1a1-0006-4a1a-8a1a-000000000006",
      "name": "Wait Before Check",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        940,
        260
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.apiBaseUrl }}{{ $('Render Job').item.json.statusUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').item.json.apiKey }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1a1a1-0007-4a1a-8a1a-000000000007",
      "name": "Check Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        260
      ],
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "sw-completed",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "completed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Completed"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "or",
                "conditions": [
                  {
                    "id": "sw-failed",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "id": "sw-error",
                    "leftValue": "={{ $json.error }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "exists"
                    }
                  },
                  {
                    "id": "sw-timeout",
                    "leftValue": "={{ $runIndex }}",
                    "rightValue": "={{ $('Config').item.json.maxAttempts }}",
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Failed"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Processing"
        }
      },
      "id": "b1a1a1a1-0008-4a1a-8a1a-000000000008",
      "name": "Job Status Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1380,
        260
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.apiBaseUrl }}{{ $('Render Job').item.json.downloadUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').item.json.apiKey }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "b1a1a1a1-0009-4a1a-8a1a-000000000009",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        140
      ]
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseDataSource": "set",
        "inputFieldName": "data",
        "options": {}
      },
      "id": "b1a1a1a1-000a-4a1a-8a1a-00000000000a",
      "name": "Return Video",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1820,
        140
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": $json.error || `Render failed with status: ${$json.status}` } }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "b1a1a1a1-000b-4a1a-8a1a-00000000000b",
      "name": "Return Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1600,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-cover",
              "leftValue": "={{ Object.keys($binary || {}).length }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a1a1a1-000c-4a1a-8a1a-00000000000c",
      "name": "Has Cover Image?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        280,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/render",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $json.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formData",
              "name": "style",
              "value": "={{ $json.style }}"
            },
            {
              "parameterType": "formData",
              "name": "theme",
              "value": "={{ $json.theme }}"
            },
            {
              "parameterType": "formData",
              "name": "background",
              "value": "={{ $json.background }}"
            },
            {
              "parameterType": "formData",
              "name": "title",
              "value": "={{ $json.title }}"
            },
            {
              "parameterType": "formData",
              "name": "description",
              "value": "={{ $json.description }}"
            },
            {
              "parameterType": "formData",
              "name": "episodeLabel",
              "value": "={{ $json.episodeLabel }}"
            },
            {
              "parameterType": "formData",
              "name": "languageCode",
              "value": "={{ $json.languageCode }}"
            },
            {
              "parameterType": "formData",
              "name": "fontColor",
              "value": "={{ $json.fontColor }}"
            },
            {
              "parameterType": "formData",
              "name": "highlightColor",
              "value": "={{ $json.highlightColor }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "audio",
              "inputDataFieldName": "={{ Object.keys($binary || {}).find(k => /audio/i.test(k)) ?? Object.keys($binary || {})[0] }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "cover",
              "inputDataFieldName": "={{ Object.keys($binary || {}).find(k => /cover|image/i.test(k)) ?? Object.keys($binary || {})[1] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1a1a1-000d-4a1a-8a1a-00000000000d",
      "name": "Upload Audio + Cover",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        380
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "job-1",
              "name": "statusUrl",
              "type": "string",
              "value": "={{ $json.statusUrl }}"
            },
            {
              "id": "job-2",
              "name": "downloadUrl",
              "type": "string",
              "value": "={{ $json.downloadUrl }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1a1a1-000e-4a1a-8a1a-00000000000e",
      "name": "Render Job",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        260
      ]
    }
  ],
  "connections": {
    "Kinetic Render Form": {
      "main": [
        [
          {
            "node": "Read Form Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Form Fields": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Has Cover Image?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Audio": {
      "main": [
        [
          {
            "node": "Render Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait Before Check": {
      "main": [
        [
          {
            "node": "Check Job Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Job Status": {
      "main": [
        [
          {
            "node": "Job Status Router",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Job Status Router": {
      "main": [
        [
          {
            "node": "Download Video",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Error",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait Before Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Video": {
      "main": [
        [
          {
            "node": "Return Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Cover Image?": {
      "main": [
        [
          {
            "node": "Upload Audio + Cover",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Upload Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Audio + Cover": {
      "main": [
        [
          {
            "node": "Render Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Job": {
      "main": [
        [
          {
            "node": "Wait Before Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "kinetic-typography-pipeline"
  }
}
