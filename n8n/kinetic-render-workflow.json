{
  "name": "Kinetic Typography - Upload & Wait",
  "nodes": [
    {
      "parameters": {
        "content": "## Setup\n1. Open **Config** below and set `apiBaseUrl` to where the Kinetic Typography API is reachable from n8n (e.g. `http://kinetic-typography:4000` if both are on the same Docker network, or `http://localhost:4000`).\n2. If the API has `API_KEY` set, put the same value in `apiKey`.\n3. Activate this workflow, then copy the Webhook node's Production URL.\n\n## Call it\n```\ncurl -X POST <webhook-url> \\\n  -F \"audio=@episode.mp3\" \\\n  -F \"style=focus-word\"\n```\nThe request stays open until the video is fully rendered (transcription + render can\ntake minutes) and responds with the MP4 as the body. See docs/N8N_WORKFLOW.md for\ntimeout settings you may need to raise (n8n, and any reverse proxy in front of it).",
        "height": 340,
        "width": 420
      },
      "id": "b1a1a1a1-0001-4a1a-8a1a-000000000001",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-360, -80]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kinetic-render",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1a1a1a1-0002-4a1a-8a1a-000000000002",
      "name": "Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 260],
      "webhookId": "kinetic-render"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "cfg-1", "name": "apiBaseUrl", "type": "string", "value": "http://localhost:4000" },
            { "id": "cfg-2", "name": "apiKey", "type": "string", "value": "" },
            { "id": "cfg-3", "name": "style", "type": "string", "value": "={{ $json.body.style || 'word-pop' }}" },
            { "id": "cfg-4", "name": "title", "type": "string", "value": "={{ $json.body.title || '' }}" },
            { "id": "cfg-5", "name": "description", "type": "string", "value": "={{ $json.body.description || '' }}" },
            { "id": "cfg-6", "name": "episodeLabel", "type": "string", "value": "={{ $json.body.episodeLabel || '' }}" },
            { "id": "cfg-7", "name": "languageCode", "type": "string", "value": "={{ $json.body.languageCode || 'en' }}" },
            { "id": "cfg-8", "name": "pollSeconds", "type": "number", "value": 15 },
            { "id": "cfg-9", "name": "maxAttempts", "type": "number", "value": 80 }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "b1a1a1a1-0003-4a1a-8a1a-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-140, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/render",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $json.apiKey }}" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formData", "name": "style", "value": "={{ $json.style }}" },
            { "parameterType": "formData", "name": "title", "value": "={{ $json.title }}" },
            { "parameterType": "formData", "name": "description", "value": "={{ $json.description }}" },
            { "parameterType": "formData", "name": "episodeLabel", "value": "={{ $json.episodeLabel }}" },
            { "parameterType": "formData", "name": "languageCode", "value": "={{ $json.languageCode }}" },
            { "parameterType": "formBinaryData", "name": "audio", "inputDataFieldName": "audio" }
          ]
        },
        "options": {}
      },
      "id": "b1a1a1a1-0004-4a1a-8a1a-000000000004",
      "name": "Upload Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 260]
    },
    {
      "parameters": {
        "amount": "={{ $('Config').item.json.pollSeconds }}",
        "unit": "seconds"
      },
      "id": "b1a1a1a1-0005-4a1a-8a1a-000000000005",
      "name": "Wait Before Check",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [300, 260]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.apiBaseUrl }}{{ $('Upload Audio').item.json.statusUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $('Config').item.json.apiKey }}" }
          ]
        },
        "options": {}
      },
      "id": "b1a1a1a1-0006-4a1a-8a1a-000000000006",
      "name": "Check Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 260],
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "sw-completed",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "completed",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Completed"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "loose" },
                "combinator": "or",
                "conditions": [
                  {
                    "id": "sw-failed",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "failed",
                    "operator": { "type": "string", "operation": "equals" }
                  },
                  {
                    "id": "sw-error",
                    "leftValue": "={{ $json.error }}",
                    "rightValue": "",
                    "operator": { "type": "string", "operation": "exists" }
                  },
                  {
                    "id": "sw-timeout",
                    "leftValue": "={{ $runIndex }}",
                    "rightValue": "={{ $('Config').item.json.maxAttempts }}",
                    "operator": { "type": "number", "operation": "gte" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Failed"
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "Processing" }
      },
      "id": "b1a1a1a1-0007-4a1a-8a1a-000000000007",
      "name": "Job Status Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [740, 260]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.apiBaseUrl }}{{ $('Upload Audio').item.json.downloadUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $('Config').item.json.apiKey }}" }
          ]
        },
        "options": {
          "response": {
            "response": { "responseFormat": "file", "outputPropertyName": "data" }
          }
        }
      },
      "id": "b1a1a1a1-0008-4a1a-8a1a-000000000008",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 140]
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseDataSource": "set",
        "inputFieldName": "data",
        "options": {}
      },
      "id": "b1a1a1a1-0009-4a1a-8a1a-000000000009",
      "name": "Return Video",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": $json.error || `Render failed with status: ${$json.status}` } }}",
        "options": { "responseCode": 500 }
      },
      "id": "b1a1a1a1-000a-4a1a-8a1a-00000000000a",
      "name": "Return Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 380]
    }
  ],
  "connections": {
    "Upload Webhook": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Upload Audio", "type": "main", "index": 0 }]]
    },
    "Upload Audio": {
      "main": [[{ "node": "Wait Before Check", "type": "main", "index": 0 }]]
    },
    "Wait Before Check": {
      "main": [[{ "node": "Check Job Status", "type": "main", "index": 0 }]]
    },
    "Check Job Status": {
      "main": [[{ "node": "Job Status Router", "type": "main", "index": 0 }]]
    },
    "Job Status Router": {
      "main": [
        [{ "node": "Download Video", "type": "main", "index": 0 }],
        [{ "node": "Return Error", "type": "main", "index": 0 }],
        [{ "node": "Wait Before Check", "type": "main", "index": 0 }]
      ]
    },
    "Download Video": {
      "main": [[{ "node": "Return Video", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "kinetic-typography-pipeline"
  }
}
